{
  "buildCommand": "pnpm --filter @workspace/api-server build",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "artifacts/api-server/dist/index.mjs": {
      "includeFiles": "artifacts/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "artifacts/api-server/dist/index.mjs"
    }
  ]
}
